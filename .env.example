# Copy to .env and fill in what you use:  cp .env.example .env
# app/config.py loads .env automatically; variables already set in the shell take precedence.

# ── LLM backend ──────────────────────────────────────────────
# ollama | groq | openrouter | gold  (gold replays assets/examples/<ID>/<ID>.json; full-OPORD lane only)
LLM_BACKEND=openrouter
LLM_TEMPERATURE=0.2

OPENROUTER_API_KEY=
# Free models come and go; current ones: https://openrouter.ai/models?q=free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Reasoning models think before answering, which costs minutes per command; 1 re-enables it
OLLAMA_THINK=0
# A full OPORD prompt is ~4.5k tokens; below 8192 it gets truncated and the answer turns to nonsense
OLLAMA_NUM_CTX=8192

# 1 = put the full schema JSON in the OPORD prompt (use for API models: without it they invent the structure);
# 0 = schema_reference.md + required-key summary (for small local models)
LLM_FULL_SCHEMA=1

# ── Web console (webapp/server.py) ───────────────────────────
# The server takes the next free port from here, so leaving it at 8000 (usually taken) means a
# different port every restart. The browser keeps the backend choice per origin, so a moving port
# resets it and leaves the open tab pointing at a dead address. Pin it to something free.
PORT=8001

# ── Full-OPORD pipeline output ───────────────────────────────
QUIET=0
PIPELINE_STRICT=0
SAVE_PRED_FILES=1

# ── RAG / vector store ───────────────────────────────────────
VECTOR_BACKEND=chroma
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
RAG_DEBUG=0
RAG_EXAMPLE_IDS=BN_OPORD_EASY_1,BN_OPORD_EASYMED_1
RAG_EXAMPLE_MAX=2
RAG_K_FOR_LLM=6

# ── Single-command results DB ────────────────────────────────
# Leave PG_HOST empty to store results in the local SQLite file opord2json.db instead.
PG_HOST=
PG_PORT=5432
PG_DB=opord2json
PG_USER=postgres
PG_PASSWORD=

# ── Celery worker (oporder_worker.py) ────────────────────────
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
